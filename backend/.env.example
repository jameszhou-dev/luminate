# Google Gemini API key — required for the AI agent
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Port the Express server listens on (optional, defaults to 3000)
PORT=3000

# Firebase Admin — required for Firestore persistence
# Option A: path to downloaded service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option B: individual fields (useful for hosted environments)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
